{
  "name": "react-element-to-jsx-string",
  "version": "17.1.0",
  "description": "Turn a ReactElement into the corresponding JSX string.",
  "packageManager": "yarn@1.22.22+sha1.ac34549e6aa8e7ead463a7407e1c7390f61a6610",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rolldown -c && tsc -p tsconfig.build.json",
    "prebuild": "rm -rf dist/",
    "prepare": "npm run build",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "npm run lint -- --fix",
    "typecheck": "tsc --noEmit",
    "precommit": "lint-staged",
    "prepublishOnly": "npm run build",
    "prettier:fix": "prettier --write \"**/*.{js,ts,tsx,json}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "release": "./release.sh",
    "smoke": "node tests/smoke/run"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": []
  },
  "author": {
    "name": "Algolia, Inc.",
    "url": "https://github.com/algolia"
  },
  "license": "MIT",
  "repository": "algolia/react-element-to-jsx-string",
  "devDependencies": {
    "@babel/cli": "7.29.7",
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/preset-react": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@commitlint/cli": "8.3.6",
    "@commitlint/config-angular": "8.3.6",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "5.17.0",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/react-is": "19.2.0",
    "@typescript-eslint/eslint-plugin": "2.34.0",
    "@typescript-eslint/parser": "2.34.0",
    "babel-eslint": "10.1.0",
    "babel-jest": "24.9.0",
    "babel-register": "6.26.0",
    "conventional-changelog-cli": "2.2.2",
    "doctoc": "1.4.0",
    "eslint": "6.8.0",
    "eslint-config-algolia": "14.0.1",
    "eslint-config-prettier": "6.15.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jest": "22.21.0",
    "eslint-plugin-prettier": "3.4.1",
    "eslint-plugin-react": "7.31.1",
    "esm": "3.2.25",
    "expect": "27.5.1",
    "flow-bin": "0.119.1",
    "flow-copy-source": "2.0.9",
    "husky": "3.1.0",
    "jest": "27.5.1",
    "json": "10.0.0",
    "lint-staged": "10.5.4",
    "mversion": "2.0.1",
    "prettier": "1.19.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-is": "19.2.7",
    "rolldown": "1.1.0",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-is": "^19.0.0"
  },
  "dependencies": {
    "@base2/pretty-print-object": "1.0.2",
    "is-plain-object": "5.0.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>tests/setupTests.js"
    ],
    "transform": {
      "^.+\\.[tj]sx?$": "babel-jest"
    }
  }
}
